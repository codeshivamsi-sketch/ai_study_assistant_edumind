{
  "name": "notifications",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "copy-proto": "mkdir -p proto && cp ../../proto/notifications.proto proto/notifications.proto",
    "build": "npm run copy-proto && npx prisma generate && tsc",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test dist/test"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.11.0",
    "@grpc/proto-loader": "^0.7.13",
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.28.0",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^6.1.0",
    "typescript": "^5.6.3"
  }
}
